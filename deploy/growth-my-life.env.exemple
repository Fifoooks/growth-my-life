# Copie ce fichier en ~/.config/growth-my-life.env et adapte les chemins.

# Ton vault Obsidian, et le dossier des relevés à l'intérieur
VAULT=/chemin/vers/ton/vault
RELEVES_DIR=/chemin/vers/ton/vault/Growth my life/Relevés
# Le brief de l'agent de nuit (copie de agent/executant-de-nuit.md, à personnaliser)
BRIEF=/chemin/vers/ton/vault/Growth my life/Executant de nuit.md
# Dossier qui contient tes projets de code (leurs commits deviennent des faits). Optionnel.
PROJETS_DIR=/chemin/vers/tes/projets
RUN_DIR=/chemin/vers/growth-my-life/run
CLAUDE_BIN=claude

# Chemins du vault que l'agent ne lit jamais, relatifs au vault, séparés par « ; »
PRIVES=Journal intime.md;Santé/Ordonnances

# Ton prénom sur la fiche, et le nom de ton coach IA
NOM=Moi
COACH=Coach

# Promethee (temps de focus). Laisse vide si tu ne l'utilises pas.
PROMETHEE_MCP=
PROMETHEE_URL=https://mcp.promethee.io/mcp

# Webhook appelé quand un passage rate (n8n, ou autre). Optionnel.
N8N_ALERTE_URL=

# La page : garde 127.0.0.1 tant que tu n'as pas un réseau privé (Tailscale, Meshnet, WireGuard…).
# Ne l'expose jamais sur internet : il n'y a pas d'authentification.
HOST=127.0.0.1
PORT=5690
TZ=Europe/Paris
PUBLIC_DIR=/chemin/vers/growth-my-life/front/dist
